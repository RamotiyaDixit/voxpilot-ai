# API
NODE_ENV=development
API_PORT=4100
WEB_ORIGIN=http://localhost:3000

# MySQL (optional for demo mode; Docker Compose starts MySQL)
DATABASE_URL=mysql://voxpilot:voxpilot@localhost:3307/voxpilot

# LLM provider (optional; without a key, the API uses safe demo responses)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Never expose provider secrets through NEXT_PUBLIC_* variables.
